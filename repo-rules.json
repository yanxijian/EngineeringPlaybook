{
  "version": 1,
  "skip_dirs": [
    ".git"
  ],
  "skip_prefixes": [],
  "skip_globs": [],
  "encoding": [
    {
      "glob": "*.md",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.sh",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "scripts/repo_rules.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".githooks/pre-commit",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [],
    "limit": 140,
    "tab_width": 4
  },
  "forbidden": [],
  "headers": {
    "globs": [],
    "first_line": "#pragma once",
    "forbid_namespace_using": true
  },
  "versions": [],
  "changelog": null,
  "required_files": [
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md",
    "REVIEW-PROTOCOL.md",
    "repo-rules.json",
    "scripts/repo_rules.py",
    ".githooks/pre-commit",
    ".github/workflows/hygiene.yml"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "languages": {
      "default": "README.md",
      "variants": [
        "README.zh-CN.md",
        "README.ja.md",
        "README.ko.md"
      ],
      "switch_line": true,
      "stale": "warning"
    }
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": [
      "\\* text=auto eol=lf"
    ]
  },
  "comments": {
    "english": true
  },
  "commit_message": {
    "english": true
  },
  "readme_badges": {
    "files": [
      "README.md",
      "README.zh-CN.md",
      "README.ja.md",
      "README.ko.md"
    ],
    "min": 3,
    "require": [
      "actions/workflows/",
      "img.shields.io/badge/License"
    ]
  },
  "about": {
    "description": "Reusable design-review protocol, role instructions, templates and a cross-platform structure checker | 可复用的设计评审协议、角色指令、模板与跨平台结构检查脚本",
    "order": "en-zh"
  }
}
